<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ring.MainPage"
             xmlns:viewmodel="clr-namespace:Ring.ViewModel"
             x:DataType="viewmodel:MainViewModel">
    <VerticalStackLayout>

        <Label
            Text="Ring"
            Padding="20"
            Style="{StaticResource Headline}"
            SemanticProperties.HeadingLevel="Level1" />

        <Button
            x:Name="msgButton"
            Text="Open"
            Margin="5"
            IsEnabled="{Binding ButtonIsEnabled}"
            Command="{Binding OpenCommand}"
            WidthRequest="100"
            SemanticProperties.Hint="Send or unsend a message"
            HorizontalOptions="Center" />

        <Button
            x:Name="rmvButton"
            Text="Remove Number"
            Margin="5"
            Command="{Binding RemoveNumberCommand}"
            SemanticProperties.Hint="Remove the number (debug)"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding ConnectionErrorText}"
            Padding="10"
            Style="{StaticResource SubHeadline}"
            SemanticProperties.HeadingLevel="Level2" />

        <Label
            Text="{Binding MessageText}"
            Padding="10"
            Style="{StaticResource SubHeadline}"
            SemanticProperties.HeadingLevel="Level2" />
    </VerticalStackLayout>
</ContentPage>
