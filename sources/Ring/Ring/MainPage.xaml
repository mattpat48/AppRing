<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Ring.MainPage"
             xmlns:viewmodel="clr-namespace:Ring.ViewModel"
             xmlns:model="clr-namespace:Ring.Utils"
             x:DataType="viewmodel:MainViewModel"
             x:Name="mainPage"
             Shell.TabBarIsVisible="True">

    <Grid
        HorizontalOptions="Center">

        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer 
                Direction="Down"
                Command="{Binding ReloadCommand}"/>
        </Grid.GestureRecognizers>

        <Label
            IsVisible="{Binding NotConnected}"
            Grid.RowSpan="1"
            Grid.ColumnSpan="1"
            Text="Connection error! Swipe up to retry."
            LineBreakMode="WordWrap"
            FontSize="Large"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <ActivityIndicator
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            Color="White"
            Margin="50"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            SemanticProperties.Hint="Activity indicator"/>

        <Grid
            IsVisible="{Binding IsContentVisible}"
            IsEnabled="{Binding IsContentVisible}"
            RowDefinitions="Auto, Auto, Auto, Auto, Auto"
            ColumnDefinitions="*"
            RowSpacing="15"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand">
            <Grid.Shadow>
                <Shadow
                    Radius="40"
                    Opacity="0.8"
                    Offset="20,20" 
                    Brush="Black" />
            </Grid.Shadow>

            <Frame
                BackgroundColor="Transparent"
                IsVisible="{Binding HasGates}"
                IsEnabled="{Binding HasGates}"
                MaximumHeightRequest="200"
                BorderColor="Transparent"
                Grid.Row="1"
                Grid.ColumnSpan="1">
                <CollectionView
                    ItemsUpdatingScrollMode="KeepLastItemInView"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand"
                    ItemsSource="{Binding Gates}"
                    ItemsLayout="VerticalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Gate">
                            <Frame
                                BackgroundColor="{StaticResource Gray800}"
                                Margin="0, 5, 0, 5">
                                <Label
                                    Text="{Binding name}"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    LineBreakMode="WordWrap"
                                    HorizontalOptions="CenterAndExpand">
                                </Label>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        NumberOfTapsRequired="1"
                                        Command="{Binding Source={x:Reference Name=mainPage}, Path=BindingContext.SelectGateCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                            </Frame>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <Label
                Text="No gates available"
                IsVisible="{Binding NoGates}"
                TextColor="White"
                FontAttributes="Bold"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="FillAndExpand"
                Style="{StaticResource SubHeadline}"
                Grid.Row="1"
                Grid.ColumnSpan="1"/>

            <ActivityIndicator
                IsRunning="{Binding IsGateLoading}"
                IsVisible="{Binding IsGateLoading}"
                Color="White"
                Margin="50"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Grid.Row="2"
                Grid.ColumnSpan="1"
                SemanticProperties.Hint="Activity indicator"/>

            <Frame
                BackgroundColor="{StaticResource Gray800}"
                IsVisible="{Binding GateSelected}"
                CornerRadius="20"
                Margin="15, 0, 15, 0"
                VerticalOptions="FillAndExpand"
                HorizontalOptions="FillAndExpand"
                HasShadow="True"
                Grid.Row="2"
                Grid.ColumnSpan="1">
                <Grid
                    RowDefinitions="Auto, Auto, Auto, Auto"
                    ColumnDefinitions="*"
                    RowSpacing="10"
                    HorizontalOptions="CenterAndExpand"
                    VerticalOptions="CenterAndExpand">
                    <Grid.Shadow>
                        <Shadow
                            Radius="20"
                            Opacity="0.8"
                            Offset="10,10" 
                            Brush="Black" />
                    </Grid.Shadow>

                    <Label
                        Text="{Binding GateNameDisplay}"
                        IsVisible="{Binding GateSelected}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"
                        Style="{StaticResource SubHeadline}"
                        Grid.Row="0"
                        Grid.ColumnSpan="2"/>

                    <Label
                        Text="You're an admin of this gate"
                        IsVisible="{Binding IsAdmin}"
                        TextColor="Green"
                        FontAttributes="Bold"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="CenterAndExpand"
                        FontSize="Small"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"/>

                    <Button
                        x:Name="openButton"
                        Text="Open"
                        Margin="5"
                        IsEnabled="{Binding IsOpenEnabled}"
                        Command="{Binding OpenCommand}"
                        SemanticProperties.Hint="Open the gate"
                        HorizontalOptions="CenterAndExpand"
                        Grid.Row="2"
                        Grid.ColumnSpan="1"/>

                    <Button
                        x:Name="addButton"
                        Text="Add User"
                        Margin="5"
                        IsEnabled="{Binding IsAddEnabled}"
                        IsVisible="{Binding IsAdmin}"
                        Command="{Binding AddUserCommand}"
                        SemanticProperties.Hint="Add a new user to the gate list"
                        HorizontalOptions="CenterAndExpand"
                        VerticalOptions="FillAndExpand"
                        Grid.Row="3"
                        Grid.ColumnSpan="1"/>

                </Grid>
            </Frame>

            <Frame
                BackgroundColor="{StaticResource Gray800}"
                IsVisible="{Binding HasLogs}"
                IsEnabled="{Binding HasLogs}"
                Margin="15, 0, 15, 0"
                HeightRequest="250"
                CornerRadius="20"
                Grid.Row="3"
                Grid.ColumnSpan="1">
                <CollectionView
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand"
                    ItemsSource="{Binding Logs}"
                    ItemsLayout="VerticalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Log">

                            <Grid
                                ColumnDefinitions="*, *"
                                ColumnSpacing="15">
                                <Label
                                    Text="{Binding phoneNumber}"
                                    Padding="0, 5, 0, 5"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    LineBreakMode="WordWrap"
                                    Grid.Column="0"
                                    HorizontalOptions="Start"/>

                                <Label
                                    Text="{Binding date}"
                                    Padding="0, 5, 0, 5"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    LineBreakMode="WordWrap"
                                    Grid.Column="1"
                                    HorizontalOptions="Start"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <Label
                Text="No logs available"
                IsVisible="{Binding NoLogs}"
                TextColor="White"
                FontAttributes="Bold"
                HorizontalOptions="CenterAndExpand"
                VerticalOptions="CenterAndExpand"
                Style="{StaticResource SubHeadline}"
                Grid.Row="4"
                Grid.ColumnSpan="1"/>

        </Grid>

    </Grid>
    
</ContentPage>
