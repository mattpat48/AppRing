<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ring.MapPage"
             Title="Map"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:viewmodel="clr-namespace:Ring.ViewModel"
             x:DataType="viewmodel:MapViewModel"
             Shell.TabBarIsVisible="True">

    <Grid
        RowDefinitions="*, *"
        RowSpacing="20"
        ColumnDefinitions="*">

        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer 
                Direction="Down"
                Swiped="refresh_Swiped"/>
        </Grid.GestureRecognizers>

        <Label
            x:Name="labelNoCon"
            IsVisible="False"
            Grid.RowSpan="1"
            Grid.ColumnSpan="1"
            Text="Connection or GPS error! Swipe up to retry."
            LineBreakMode="WordWrap"
            FontSize="Large"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <ActivityIndicator
            Grid.RowSpan="2"
            Grid.ColumnSpan="1"
            x:Name="loading"
            Color="White"
            Margin="50"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            SemanticProperties.Hint="Activity indicator"/>

        <mapsui:MapView
            x:Name="mapView" 
            Grid.RowSpan="2"
            Grid.ColumnSpan="1"/>
        
    </Grid>
</ContentPage>