<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ring.MapPage"
             Title="Map"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:viewmodel="clr-namespace:Ring.ViewModel"
             x:DataType="viewmodel:MapViewModel"
             Shell.TabBarIsVisible="True">

    <Grid>

        <Grid.GestureRecognizers>
            <SwipeGestureRecognizer 
                Direction="Down"
                Swiped="refresh_Swiped"/>
        </Grid.GestureRecognizers>

        <Label
            x:Name="labelNoCon"
            IsVisible="False"
            Text="Connection or GPS error! Swipe up to retry."
            LineBreakMode="WordWrap"
            FontSize="Large"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <ActivityIndicator
            Grid.RowSpan="2"
            Grid.ColumnSpan="1"
            x:Name="loading"
            Color="White"
            Margin="50"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            SemanticProperties.Hint="Activity indicator"/>

        <Grid
            RowDefinitions="*, *, *, *, *, *"
            x:Name="mapContainer">
            <Frame
                IsVisible="True"
                CornerRadius="20"
                Margin="5, 5, 5, 5"
                Padding="10, 10, 10, 10"
                VerticalOptions="FillAndExpand"
                HorizontalOptions="FillAndExpand"
                HasShadow="True"
                Grid.RowSpan="5">
             
                <mapsui:MapView x:Name="mapView"/>
            </Frame>

            <Grid
                Grid.Row="5"
                ColumnDefinitions="*, *"
                ColumnSpacing="20">
                <Label
                    Grid.Column="0"
                    IsVisible="{Binding GateSelected}"
                    Text="{Binding SelectedGateName}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    FontSize="20"/>
                <Button
                    Grid.Column="1"
                    IsVisible="{Binding GateSelected}"
                    Text="Open"
                    Command="{Binding OpenGateCommand}"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>
                <Label
                    Grid.ColumnSpan="2"
                    IsVisible="{Binding GateNotSelected}"
                    Text="No gate selected"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    FontSize="20"/>
            </Grid>
        </Grid>

    </Grid>
</ContentPage>