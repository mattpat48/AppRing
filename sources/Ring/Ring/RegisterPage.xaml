<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ring.RegisterPage"
             Title="Register"
             xmlns:ct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             xmlns:viewmodel="clr-namespace:Ring.ViewModel"
             x:DataType="viewmodel:RegisterViewModel"
             Shell.NavBarIsVisible="False">

    <AbsoluteLayout>

        <BoxView
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
            Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />

        <Frame
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0.5, 0.5, 0.9, 0.9"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource OffBlack}}"
            Padding="20"
            CornerRadius="20">

            <Grid
                RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
                ColumnDefinitions="Auto, Auto"
                RowSpacing="10"
                VerticalOptions="Center"
                HorizontalOptions="Center">

                <Label
                    Text="Welcome to Ring!"
                    LineBreakMode="WordWrap"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource Headline}"
                    VerticalOptions="Center"
                    Grid.Row="0"
                    Grid.ColumnSpan="2" />

                <Label
                    Text="Please enter your phone number to register"
                    LineBreakMode="WordWrap"
                    HorizontalOptions="FillAndExpand"
                    Style="{StaticResource SubHeadline}"
                    VerticalOptions="FillAndExpand"
                    Grid.Row="1"
                    Grid.ColumnSpan="2" />

                <Picker
                    Title="Country"
                    ItemsSource="{Binding PhonePrefixes}"
                    SelectedItem="{Binding SelectedPhonePrefix}"
                    x:Name="countryPicker"
                    WidthRequest="100"
                    HorizontalOptions="End"
                    Margin="10"
                    Grid.Row="2"
                    Grid.Column="0" />

                <Entry
                    Placeholder="Phone number"
                    Keyboard="Telephone"
                    Text="{Binding PhoneNumber}"
                    x:Name="phoneNumberEntry"
                    WidthRequest="200"
                    HorizontalOptions="Start"
                    Margin="10"
                    Grid.Row="2"
                    Grid.Column="1" />

                <Button
                    Text="Next"
                    IsEnabled="{Binding Source={x:Reference phoneNumberEntry}, Path=Text.Length}"
                    Command="{Binding NextCommand}"
                    SemanticProperties.Hint="Register your phone number"
                    WidthRequest="100"
                    Margin="10"
                    Grid.Row="3"
                    Grid.ColumnSpan="2" />

                <Label
                    Text="{Binding ErrorText}"
                    TextColor="Red"
                    Style="{StaticResource SubHeadline}"
                    LineBreakMode="TailTruncation"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Center"
                    Grid.Row="4"
                    Grid.ColumnSpan="2" />

                <Label
                    Text="{Binding Response}"
                    Style="{StaticResource SubHeadline}"
                    LineBreakMode="WordWrap"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand"
                    Grid.Row="5"
                    Grid.ColumnSpan="2" />
            </Grid>
                
        </Frame>
    
    </AbsoluteLayout>
    
</ContentPage>
