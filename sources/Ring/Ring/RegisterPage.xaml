<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ring.RegisterPage"
             Title="Register"
             xmlns:viewmodel="clr-namespace:Ring.ViewModel"
             x:DataType="viewmodel:RegisterViewModel"
             Shell.NavBarIsVisible="False">

    <AbsoluteLayout>

        <BoxView
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
            Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}" />

        <Frame
            AbsoluteLayout.LayoutFlags="All"
            AbsoluteLayout.LayoutBounds="0.5, 0.5, 0.9, 0.9"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource OffBlack}}"
            Padding="20">

            <VerticalStackLayout
                Grid.Row="1"
                Grid.Column="1">

                <Label Text="Welcome to Ring!"
                       Style="{StaticResource Headline}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />

                <Label Text="Please enter your phone number to register"
                       Style="{StaticResource SubHeadline}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />

                <Entry Placeholder="Numero di telefono"
                       x:Name="phoneNumberEntry"
                       Text="{Binding PhoneNumber}"
                       WidthRequest="250"
                       Keyboard="Telephone"
                       Margin="10" />

                <Button Text="Prosegui"
                        Command="{Binding RegisterCommand}"
                        SemanticProperties.Hint="Register your phone number"
                        WidthRequest="100"
                        Margin="10" />

                <Label Text="{Binding ErrorText}"
                       Style="{StaticResource SubHeadline}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
                
        </Frame>
    
    </AbsoluteLayout>
    
</ContentPage>
